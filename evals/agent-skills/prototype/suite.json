      "metadata": {
        "expected_behavior": {
          "baseline": {
            "route": "none",
            "workflow": "prototype"
          },
          "treatment": {
            "route": "prototype",
            "workflow": "prototype",
            "claim_real_integration": false
          }
        }
      }
    },
    {
      "id": "negative-production-feature",
      "kind": "negative",
      "prompt": "Implement the settled production feature according to its approved design. There is no feasibility uncertainty to explore.",
      "metadata": {
        "expected_behavior": {
          "baseline": {
            "route": "none",
            "workflow": "implementation"
          },
          "treatment": {
            "route": "none",
            "workflow": "implementation"
          }
        }
