{
  "schema_version": 1,
  "suite_id": "semver-release-native-boundaries",
  "skill_path": "skills/semver-release",
  "fixture": "evals/agent-skills/fixture",
  "adapter": {
    "command": [
      "{python}",
      "{repo}/evals/agent-skills/host_adapter.py"
    ],
    "timeout_seconds": 300,
    "max_output_bytes": 1048576
  },
  "verifier": {
    "command": [
      "{python}",
      "{repo}/evals/agent-skills/verifier.py"
    ],
    "timeout_seconds": 30,
    "max_output_bytes": 262144
  },
  "scope": {
    "allow": [],
    "deny": [
      ".agents/**",
      ".agent-workflows/**",
      ".git/**"
    ]
  },
  "budgets": {
    "absolute": {
      "interventions": 0
    },
    "relative": {
      "input_tokens": {
        "max_ratio": 4.0,
        "max_additive": 2000
      },
      "output_tokens": {
        "max_ratio": 2.5,
        "max_additive": 500
      },
      "tool_calls": {
        "max_ratio": 2.0,
        "max_additive": 3
      },
      "wall_time_seconds": {
        "max_ratio": 3.0,
        "max_additive": 10
      }
    }
  },
  "cases": [
    {
      "id": "positive-established-alternative",
      "kind": "positive",
      "prompt": "Prepare the requested v2.1.0 release using this project's mature Changesets workflow. Its version, notes and publisher authorities are documented, coherent and sufficient. No pipeline redesign is requested.",
      "metadata": {
        "expected_behavior": {
          "baseline": {
            "route": "none",
            "workflow": "release"
          },
          "treatment": {
            "route": "semver-release",
            "workflow": "release",
            "migration_interview": false,
            "preserve_existing_workflow": true
          }
        }
      }
    },
    {
      "id": "positive-explicit-redesign",
      "kind": "positive",
      "prompt": "Compare the current manual release process with changelog-backed tag-triggered automation. Recommend a design, but do not change infrastructure yet.",
      "metadata": {
        "expected_behavior": {
          "baseline": {
            "route": "none",
            "workflow": "release"
          },
          "treatment": {
            "route": "semver-release",
            "workflow": "release",
            "compare_options": true,
            "infrastructure_mutation": false
          }
        }
      }
    },
    {
      "id": "positive-tag-only-policy",
      "kind": "positive",
      "prompt": "Publish the authorized release where the repository policy explicitly defines a verified pushed tag as terminal. There is no forge release or registry publisher in this project.",
      "metadata": {
        "expected_behavior": {
          "baseline": {
            "route": "none",
            "workflow": "release"
          },
          "treatment": {
            "route": "semver-release",
            "workflow": "release",
            "create_unrequested_publisher": false
          }
        }
      }
    },
    {
      "id": "positive-unverified-publisher",
      "kind": "positive",
      "prompt": "The release tag was pushed, but the repository-owned registry publication job has failed. Report the release status.",
      "metadata": {
        "expected_behavior": {
          "baseline": {
            "route": "none",
            "workflow": "release"
          },
          "treatment": {
            "route": "semver-release",
            "workflow": "release",
            "claim_complete": false
          }
        }
      }
    },
    {
      "id": "negative-ordinary-commit",
      "kind": "negative",
      "prompt": "Commit the scoped README correction locally. Do not create a version, release or tag.",
      "metadata": {
        "expected_behavior": {
          "baseline": {
            "route": "none",
            "workflow": "commit"
          },
          "treatment": {
            "route": "conventional-commit",
            "workflow": "commit"
          }
        }
      }
    }
  ]
}
