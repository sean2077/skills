{
  "schema_version": 1,
  "suite_id": "deep-interview-mode-selection",
  "skill_path": "skills/deep-interview",
  "fixture": "evals/agent-skills/fixture",
  "adapter": {
    "command": [
      "{python}",
      "{repo}/evals/agent-skills/host_adapter.py"
    ],
    "timeout_seconds": 300,
    "max_output_bytes": 1048576
  },
  "verifier": {
    "command": [
      "{python}",
      "{repo}/evals/agent-skills/verifier.py"
    ],
    "timeout_seconds": 30,
    "max_output_bytes": 262144
  },
  "scope": {
    "allow": [],
    "deny": [
      ".agents/**",
      ".agent-workflows/**",
      ".git/**"
    ]
  },
  "budgets": {
    "absolute": {
      "interventions": 0
    },
    "relative": {
      "input_tokens": {
        "max_ratio": 4.0,
        "max_additive": 2000
      },
      "output_tokens": {
        "max_ratio": 2.5,
        "max_additive": 500
      },
      "tool_calls": {
        "max_ratio": 2.0,
        "max_additive": 3
      },
      "wall_time_seconds": {
        "max_ratio": 3.0,
        "max_additive": 10
      }
    }
  },
  "cases": [
    {
      "id": "positive-adaptive-interview",
      "kind": "positive",
      "prompt": "Interview me to turn a vague internal dashboard idea into an approved specification. This is one session and no external market facts are needed.",
      "metadata": {
        "expected_behavior": {
          "baseline": {
            "route": "none",
            "workflow": "interview"
          },
          "treatment": {
            "route": "deep-interview",
            "workflow": "interview",
            "mode": "adaptive",
            "question_batch_policy": "adaptive",
            "approval_required": true,
            "external_research": "conditional"
          }
        }
      }
    },
    {
      "id": "positive-structured-intake-batch",
      "kind": "positive",
      "prompt": "Interview me to define a small internal tool. To minimize back-and-forth, ask these five independent decisions together in your first turn: target users, supported platforms, data sensitivity, delivery deadline, and success metric. This is one session and no external research is needed.",
      "metadata": {
        "expected_behavior": {
          "baseline": {
            "route": "none",
            "workflow": "interview"
          },
          "treatment": {
            "route": "deep-interview",
            "workflow": "interview",
            "mode": "adaptive",
            "question_batch_policy": "adaptive",
            "first_turn_question_count": 5,
            "approval_required": true,
            "external_research": "conditional"
          }
        }
      }
    },
    {
      "id": "positive-branching-sequential-interview",
      "kind": "positive",
      "prompt": "Interview me to decide whether to replace a production database. Begin with one question about the current failure mode because the later questions depend on that answer; do not send a checklist up front. This is one session and no external research is needed.",
      "metadata": {
        "expected_behavior": {
          "baseline": {
            "route": "none",
            "workflow": "interview"
          },
          "treatment": {
            "route": "deep-interview",
            "workflow": "interview",
            "mode": "adaptive",
            "question_batch_policy": "adaptive",
            "first_turn_question_count": 1,
            "approval_required": true,
            "external_research": "conditional"
          }
        }
      }
    },
    {
      "id": "positive-auditable-interview",
      "kind": "positive",
      "prompt": "Interview me about this service, preserve a versioned specification across sessions, and record an auditable approval digest for the exact specification I approve.",
      "metadata": {
        "expected_behavior": {
          "baseline": {
            "route": "none",
            "workflow": "interview"
          },
          "treatment": {
            "route": "deep-interview",
            "workflow": "interview",
            "mode": "persistent",
            "persistent_state": true,
            "approval_required": true
          }
        }
      }
    },
    {
      "id": "negative-approved-implementation",
      "kind": "negative",
      "prompt": "The attached specification is already approved. Implement its small logging change and run the focused tests.",
      "metadata": {
        "expected_behavior": {
          "baseline": {
            "route": "none",
            "workflow": "implementation"
          },
          "treatment": {
            "route": "none",
            "workflow": "implementation"
          }
        }
      }
    },
    {
      "id": "confusable-single-clarification",
      "kind": "confusable",
      "prompt": "Before answering, ask me which of the two output formats I prefer; no full specification is needed.",
      "metadata": {
        "expected_behavior": {
          "baseline": {
            "route": "none",
            "workflow": "clarification"
          },
          "treatment": {
            "route": "none",
            "workflow": "clarification"
          }
        }
      }
    },
    {
      "id": "positive-clear-short-approval",
      "kind": "positive",
      "prompt": "Continue the active adaptive requirements interview. The complete specification was just presented and you asked \"Do you approve this specification?\" The user replies \"ok\". Implementation has not been authorized. Identify the next state.",
      "metadata": {
        "expected_behavior": {
          "baseline": {
            "route": "none",
            "workflow": "interview"
          },
          "treatment": {
            "route": "deep-interview",
            "workflow": "interview",
            "mode": "adaptive",
            "approval_accepted": true,
            "implementation_authorized": false
          }
        }
      }
    },
    {
      "id": "positive-answer-not-whole-approval",
      "kind": "positive",
      "prompt": "Continue the active interview. You have only asked \"Should exports include CSV?\" and the user replies \"yes\". The complete specification has not been presented. Identify the approval state.",
      "metadata": {
        "expected_behavior": {
          "baseline": {
            "route": "none",
            "workflow": "interview"
          },
          "treatment": {
            "route": "deep-interview",
            "workflow": "interview",
            "approval_accepted": false
          }
        }
      }
    },
    {
      "id": "positive-adaptive-cosmetic-edit",
      "kind": "positive",
      "prompt": "In the active adaptive interview, the user approved the complete specification. You correct a misspelling without changing meaning, scope, risk, or acceptance. Identify whether its approval still applies.",
      "metadata": {
        "expected_behavior": {
          "baseline": {
            "route": "none",
            "workflow": "interview"
          },
          "treatment": {
            "route": "deep-interview",
            "workflow": "interview",
            "mode": "adaptive",
            "reapproval_required": false
          }
        }
      }
    },
    {
      "id": "positive-adaptive-material-edit",
      "kind": "positive",
      "prompt": "In the active adaptive interview, the user approved a read-only dashboard. A new requirement would grant operators permission to delete records. Assess approval before including that change.",
      "metadata": {
        "expected_behavior": {
          "baseline": {
            "route": "none",
            "workflow": "interview"
          },
          "treatment": {
            "route": "deep-interview",
            "workflow": "interview",
            "mode": "adaptive",
            "reapproval_required": true
          }
        }
      }
    },
    {
      "id": "positive-persistent-byte-change",
      "kind": "positive",
      "prompt": "In the active persistent interview runtime, a crystallized specification has an approved exact file digest. Only Markdown whitespace changes before complete is invoked. Assess the approval and completion boundary.",
      "metadata": {
        "expected_behavior": {
          "baseline": {
            "route": "none",
            "workflow": "interview"
          },
          "treatment": {
            "route": "deep-interview",
            "workflow": "interview",
            "mode": "persistent",
            "reapproval_required": true
          }
        }
      }
    },
    {
      "id": "positive-host-resume",
      "kind": "positive",
      "prompt": "Continue a requirements interview using the host-native resumed conversation. The user needs no scoring, repository-owned approval digest, audit log, or cross-host handoff.",
      "metadata": {
        "expected_behavior": {
          "baseline": {
            "route": "none",
            "workflow": "interview"
          },
          "treatment": {
            "route": "deep-interview",
            "workflow": "interview",
            "mode": "adaptive",
            "persistent_state": false
          }
        }
      }
    }
  ]
}
